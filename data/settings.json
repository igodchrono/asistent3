{
  "API_URL": "http://127.0.0.1:1234/v1",
  "API_KEY": "lm-studio",
  "MODEL_NAME": "qwen3-vl-8b-instruct-abliterated-v2.0",
  "TEMPERATURE": 0.4,
  "MAX_TOKENS": 1000,
  "PLUGINS_ENABLED": true,
  "PLUGINS": {
    "auto_messages": true,
    "avatar": true,
    "browser_search": true,
    "character_log": true,
    "deep_think": true,
    "emotion": true,
    "memory": true,
    "memory_persona": true,
    "pc_control": true,
    "screen_react": true,
    "screen_vision": true,
    "voice": true
  },
  "PLUGIN_SETTINGS": {
    "auto_messages": {
      "enabled": true,
      "interval_minutes": 1,
      "chance_percent": 90,
      "quiet_start": 0,
      "quiet_end": 8,
      "allow_flirty": true
    },
    "avatar": {
      "show": true,
      "size": 300,
      "always_on_top": true,
      "corner": "bottom_left",
      "anim_ms": 80,
      "react_to_reply": true
    },
    "browser_search": {
      "enabled": true,
      "search_engine": "google",
      "browser_name": "default",
      "browser_path": "",
      "open_browser": true,
      "open_best_result": true
    },
    "deep_think": {
      "enabled": true,
      "always_on": false,
      "max_tokens": 4096,
      "temperature": 0.35,
      "set_thinking_avatar": true,
      "extra_triggers": "разбери|проанализируй|сравни|аргументируй"
    },
    "emotion": {
      "enabled": true,
      "confidence_threshold": 0.4,
      "hold_seconds": 20,
      "add_mood_to_prompt": true,
      "apply_before_llm": true,
      "use_compounds": true,
      "force_change_on_any_message": true,
      "debug_log": true
    },
    "pc_control": {
      "enabled": true,
      "confirmation_timeout": 20,
      "allow_process_close": true,
      "allow_window_control": true
    },
    "screen_react": {
      "enabled": true,
      "interval_seconds": 20,
      "use_window_title": true,
      "use_screenshot_hints": true,
      "react_on_user_screen_question": true,
      "chat_comments": true,
      "comment_chance_percent": 15,
      "min_confidence": 0.45,
      "hold_same_seconds": 25,
      "debug_log": true,
      "quiet_start": 1,
      "quiet_end": 7,
      "extra_rules": "bomba=surprised|котик=happy|code=thinking"
    },
    "screen_vision": {
      "enabled": true,
      "max_side": 1600,
      "monitor": "1",
      "save_screenshot": true
    },
    "memory": {
      "enabled": true,
      "inject_prompt": true,
      "auto_remember_user": true,
      "default_pinned": true,
      "search_limit": 8,
      "max_prompt_chars": 2000
    },
    "voice": {
      "listen_enabled": false,
      "voice_id": "xenia",
      "microphone_index": -1,
      "speaker_index": -1,
      "voice_rate": 175,
      "voice_volume": 1.0,
      "stt_engine": "vosk",
      "tts_engine": "silero",
      "tts_api_url": "",
      "tts_api_key": "",
      "tts_model": "tts-1"
    }
  },
  "ACTIVE_CHARACTER": "лисичка",
  "SYSTEM_PROMPT": "Ты полезный ассистент. Отвечай кратко и по делу на языке пользователя."
}
